{
  "name": "kids-brand-ai",
  "version": "0.1.0",
  "description": "Platform AI agent untuk bisnis baju anak (brand sendiri): Sales/Stock Tracker & Production Advisor",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli/index.ts",
